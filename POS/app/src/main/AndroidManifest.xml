<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.POS">
        
        <!-- Splash Screen as Launcher -->
        <activity
            android:name=".Views.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.POS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Screen -->
        <activity
            android:name=".Views.LoginActivity"
            android:exported="false"
            android:label="Connexion"
            android:theme="@style/Theme.POS" />

        <!-- Main Dashboard -->
        <activity
            android:name=".Views.MainActivity"
            android:exported="false"
            android:label="BANK Dashboard"
            android:theme="@style/Theme.POS" />

        <activity android:name=".Views.ProfileActivity" android:exported="false" android:theme="@style/Theme.POS" />
        <activity android:name=".Views.TransferActivity" android:exported="false" android:theme="@style/Theme.POS" />
        <activity android:name=".Views.HistoryActivity" android:exported="false" android:theme="@style/Theme.POS" />
        <activity android:name=".Views.ReceiptActivity" android:exported="false" android:theme="@style/Theme.POS" />

    </application>

</manifest>