<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Professional Banking Theme -->
    <style name="Theme.POS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Main Colors -->
        <item name="colorPrimary">@color/bank_primary</item>
        <item name="colorPrimaryVariant">@color/bank_secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/bank_primary</item>
        
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/bg_soft</item>
        
        <!-- Card & Surface Colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        
        <!-- Global Text Colors -->
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>
</resources>